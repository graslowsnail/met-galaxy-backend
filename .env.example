# Environment Configuration
NODE_ENV=production

# Server Configuration
PORT=8080

# Database Configuration
# Replace with your production Neon database URL
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Metadata search uses text-embedding-3-small at 1,536 dimensions. This must
# match the vectors stored in met-galaxy_artwork.txtVec.
OPENAI_API_KEY=your_openai_api_key

# This service must run ViT-L-14/openai and return normalized 768-dimensional
# text vectors matching met-galaxy_image_asset.imageEmbedding.
OPENCLIP_TEXT_EMBEDDING_URL=http://localhost:8090
OPENCLIP_TEXT_AUTH_TOKEN=replace-with-a-shared-secret

# AWS Configuration (use the default SDK credential chain)
AWS_REGION=us-east-1
# AWS_PROFILE=met-galaxy

# Image Delivery
S3_BUCKET_NAME=met-artworks-images
IMAGE_CDN_BASE_URL=https://d2pvxr3eb77vb4.cloudfront.net
IMAGE_INGESTION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/met-galaxy-image-ingestion
IMAGE_EMBEDDING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/met-galaxy-image-embedding

# Image ingestion limits
IMAGE_INGESTION_CONCURRENCY=4
IMAGE_INGESTION_FETCH_RETRIES=3
IMAGE_INGESTION_MAX_ATTEMPTS=5
IMAGE_INGESTION_LEASE_SECONDS=900

# CORS Configuration
# Comma-separated list of allowed origins for production
CORS_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com
