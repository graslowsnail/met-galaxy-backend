{
  "name": "met-galaxy-backend",
  "version": "1.0.0",
  "description": "TypeScript Express Backend",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "download-images": "node scripts/download-images.js",
    "ingest-images": "venv/bin/python -u scripts/image_ingestion_worker.py",
    "generate-embeddings": "venv-embeddings/bin/python -u scripts/image_embedding_worker.py",
    "generate-text-embeddings": "venv-embeddings/bin/python -u scripts/generate-text-embeddings.py",
    "rebuild-hnsw-indexes": "venv-embeddings/bin/python -u scripts/rebuild_hnsw_indexes.py",
    "build-pca": "venv-embeddings/bin/python -u scripts/pca_build.py",
    "build-search-review": "venv-embeddings/bin/python -u scripts/build-search-review.py",
    "review-image-duplicates": "venv/bin/python -u scripts/review_image_duplicates.py",
    "serve-openclip-text": "venv-embeddings/bin/python -u scripts/openclip_text_service.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "openai": "^6.25.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.1",
    "typescript": "^5.8.3"
  }
}
